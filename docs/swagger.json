{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Node.js API",
    "description": "API do obsługi kontaktów z wykorzystaniem MongoDB i Swagger UI",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "https://twoja-aplikacja.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Operacje związane z kontaktami"
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Pobierz listę kontaktów",
        "operationId": "getContacts",
        "description": "Pobiera listę wszystkich kontaktów",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Ile kontaktów pobrać (domyślnie 10)"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Którą stronę pobrać (domyślnie 1)"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista kontaktów",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Contact"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nieautoryzowany dostęp"
          }
        }
      },
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Dodaj nowy kontakt",
        "operationId": "createContact",
        "description": "Tworzy nowy kontakt i zwraca jego szczegóły",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Contact"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Kontakt został utworzony",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          },
          "400": {
            "description": "Nieprawidłowe dane wejściowe"
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Pobierz informacje o konkretnym kontakcie",
        "operationId": "getContactById",
        "description": "Pobiera szczegółowe informacje o kontakcie na podstawie jego ID.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID kontaktu, który chcesz pobrać"
          }
        ],
        "responses": {
          "200": {
            "description": "Szczegóły kontaktu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          },
          "404": {
            "description": "Kontakt nie znaleziony"
          }
        }
      },
      "patch": {
        "tags": [
          "Contacts"
        ],
        "summary": "Edytuj kontakt",
        "operationId": "updateContact",
        "description": "Aktualizuje informacje o kontakcie na podstawie jego ID.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID kontaktu, który chcesz edytować"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Contact"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kontakt został zaktualizowany"
          },
          "400": {
            "description": "Nieprawidłowe dane wejściowe"
          },
          "404": {
            "description": "Kontakt nie znaleziony"
          }
        }
      },
      "delete": {
        "tags": [
          "Contacts"
        ],
        "summary": "Usuń kontakt",
        "operationId": "deleteContact",
        "description": "Usuwa kontakt na podstawie jego ID.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID kontaktu, który chcesz usunąć"
          }
        ],
        "responses": {
          "204": {
            "description": "Kontakt został usunięty"
          },
          "404": {
            "description": "Kontakt nie znaleziony"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Contact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      }
    }
  }
}